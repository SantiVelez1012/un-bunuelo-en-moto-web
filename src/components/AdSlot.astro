---
interface Props {
  slot: string;
  label?: string;
}

const { slot, label = 'Publicidad' } = Astro.props;
const clientId = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT_ID;
const isConfigured = Boolean(clientId && slot);
---

{isConfigured && (
  <aside class="mx-auto flex min-h-[120px] w-full max-w-[1176px] items-center justify-center overflow-hidden px-5 py-8 md:px-10 lg:px-0" aria-label={label}>
    <ins
      class="adsbygoogle block min-h-[90px] w-full"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>{`(adsbygoogle = window.adsbygoogle || []).push({});`}</script>
  </aside>
)}
