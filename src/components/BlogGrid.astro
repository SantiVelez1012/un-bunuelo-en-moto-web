---
// src/components/BlogGrid.astro
import { defineComponent } from 'vue';
import { useHead } from '@vueuse/head';

export default defineComponent({
  name: 'BlogGrid',
  setup() {
    useHead({
      title: 'Blog Grid',
    });
    return () => (
      <section class="bg-retro-dark py-16 rounded-3xl backdrop-blur-md shadow-lg">
        <h2 class="text-2xl text-neon mb-8">Últimos Kilómetros</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-asfalto/10 p-4 rounded-3xl backdrop-blur-md shadow-lg">
            <h3 class="text-neon">Artículo 1</h3>
            <p class="text-retro-crema">Descripción breve del artículo 1</p>
          </div>
          <div class="bg-asfalto/10 p-4 rounded-3xl backdrop-blur-md shadow-lg">
            <h3 class="text-neon">Artículo 2</h3>
            <p class="text-retro-crema">Descripción breve del artículo 2</p>
          </div>
          <div class="bg-asfalto/10 p-4 rounded-3xl backdrop-blur-md shadow-lg">
            <h3 class="text-neon">Artículo 3</h3>
            <p class="text-retro-crema">Descripción breve del artículo 3</p>
          </div>
        </div>
      </section>
    );
  },
});
