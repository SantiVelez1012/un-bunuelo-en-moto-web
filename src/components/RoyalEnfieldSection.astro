---
const instagramUrl = 'https://www.instagram.com/unbunueloenmoto/';
---

<section class="mx-auto max-w-[1320px] px-5 py-20 md:px-10 md:py-28 lg:px-[72px]" id="royal-enfield" data-reveal>
  <div class="grid overflow-hidden rounded-2xl bg-bunuelo text-retro-dark md:grid-cols-[1.1fr_.9fr]">
    <div class="p-7 sm:p-9 md:p-14">
      <h2 class="max-w-3xl text-balance text-[clamp(2.625rem,6vw,5rem)] font-bold leading-[0.98] tracking-[-0.03em]">¿Buscas una Royal Enfield?</h2>
      <p class="mt-6 max-w-[60ch] text-base leading-relaxed text-retro-dark/85 md:text-lg">Si estás en Medellín o Bogotá y quieres comprar una Royal Enfield, escríbeme por Instagram para consultar el beneficio disponible para la comunidad.</p>
      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <a class="inline-flex min-h-12 items-center justify-center rounded-full bg-retro-dark px-6 text-sm font-bold text-retro-crema transition-colors duration-200 hover:bg-asfalto active:scale-[0.98]" href={instagramUrl} target="_blank" rel="noreferrer">Consultar beneficio</a>
        <span class="text-sm font-semibold text-retro-dark/80">Sujeto a condiciones y disponibilidad.</span>
      </div>
    </div>
    <div class="relative min-h-[260px] bg-retro-dark/10 md:min-h-full">
      <slot name="image">
        <img class="size-full min-h-[260px] object-cover" src="/images/royal-enfield.jpeg" alt="Royal Enfield Hunter 350" width="900" height="700" loading="lazy" />
      </slot>
    </div>
  </div>
</section>
