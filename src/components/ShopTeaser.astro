---
// src/components/ShopTeaser.astro
import { defineComponent } from 'vue';
import { useHead } from '@vueuse/head';

export default defineComponent({
  name: 'ShopTeaser',
  setup() {
    useHead({
      title: 'Shop Teaser',
    });
    return () => (
      <section class="bg-retro-dark py-24 rounded-3xl backdrop-blur-md shadow-lg">
        <h2 class="text-4xl text-neon mb-8">Tienda Destacada</h2>
        <p class="text-2xl text-retro-crema mb-8">Encuentra lo que necesitas aquí</p>
        <button class="bg-bunuelo px-8 py-4 rounded-3xl text-neon hover:bg-bunuelo-dark">
          Visita la Tienda
        </button>
      </section>
    );
  },
});
