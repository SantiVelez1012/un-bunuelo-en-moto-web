---
interface Props {
  currentPage?: 'home' | 'blog' | 'none';
}

const { currentPage = 'home' } = Astro.props;
const youtubeUrl = 'https://youtube.com/@unbunueloenmoto';
const homeLink = currentPage === 'home' ? '/' : '/';
---

<header class="absolute inset-x-0 top-0 z-20 mx-auto max-w-[1320px] px-5 py-5 md:px-10 lg:px-[72px]">
  <div class="flex items-center justify-between gap-3 lg:gap-4">
    <a class="flex min-h-11 items-center gap-2.5 text-sm font-bold tracking-wide lg:mr-2" href={homeLink} aria-label="Un Buñuelo en Moto, inicio">
      <img class="size-10 object-contain" src="/images/un-bunuelo-en-moto.png" alt="Logo de Un Buñuelo en Moto" width="40" height="40" />
      <span>Un Buñuelo en Moto</span>
    </a>

    <nav class="hidden items-center gap-8 text-[13px] text-retro-crema/70 lg:ml-6 lg:flex" aria-label="Navegación principal">
      {currentPage === 'home' ? <>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/" data-scroll-target="sobre-mi">Sobre mí</a>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/" data-scroll-target="contenido">Redes</a>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/blog">Blog</a>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/" data-scroll-target="comunidad">Comunidad</a>
      </> : currentPage === 'blog' ? <>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/">Inicio</a>
        <a class="text-neon transition-all duration-300 ease-out hover:-translate-y-0.5" href="/blog" aria-current="page">Blog</a>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/" data-scroll-target="sobre-mi">Sobre mí</a>
      </> : <>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/">Inicio</a>
        <a class="transition-all duration-300 ease-out hover:-translate-y-0.5 hover:text-neon" href="/blog">Blog</a>
      </>}
    </nav>

    <div class="ml-auto flex items-center gap-3 lg:gap-4">
      <a class="hidden min-h-10 items-center justify-center rounded-full bg-bunuelo px-4 text-xs font-bold text-retro-dark transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-bunuelo-dark lg:inline-flex" href={youtubeUrl} target="_blank" rel="noreferrer">Ver el canal</a>

      <div class="relative md:hidden">
        <button
          id="mobile-menu-button"
          class="flex h-11 w-11 items-center justify-center rounded-full border border-asfalto/20 bg-asfalto/10 text-retro-crema transition-all duration-300 ease-out hover:border-neon hover:text-neon hover:-translate-y-0.5"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
          aria-label="Abrir menú"
        >
          <span class="flex flex-col gap-1.5">
            <span class="block h-0.5 w-5 rounded-full bg-current"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current"></span>
            <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          </span>
        </button>

        <div id="mobile-menu-panel" class="absolute right-0 top-full mt-3 hidden w-[220px] rounded-2xl border border-asfalto/20 bg-retro-dark/95 p-3 shadow-2xl backdrop-blur-md transition-all duration-300 ease-out" role="menu" aria-label="Menú móvil">
          <nav class="flex flex-col gap-2 text-sm text-retro-crema/80" aria-label="Menú móvil">
            {currentPage === 'home' ? <>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/" data-scroll-target="sobre-mi">Sobre mí</a>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/" data-scroll-target="contenido">Redes</a>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/blog">Blog</a>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/" data-scroll-target="comunidad">Comunidad</a>
            </> : currentPage === 'blog' ? <>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/">Inicio</a>
              <a class="rounded-xl px-3 py-2 text-neon transition-all duration-300 ease-out hover:bg-asfalto/10" href="/blog" aria-current="page">Blog</a>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/" data-scroll-target="sobre-mi">Sobre mí</a>
            </> : <>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/">Inicio</a>
              <a class="rounded-xl px-3 py-2 transition-all duration-300 ease-out hover:bg-asfalto/10 hover:text-neon" href="/blog">Blog</a>
            </>}
            <a class="mt-2 inline-flex min-h-11 items-center justify-center rounded-full bg-bunuelo px-4 text-xs font-bold text-retro-dark transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-bunuelo-dark" href={youtubeUrl} target="_blank" rel="noreferrer">Ver el canal</a>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenuPanel = document.getElementById('mobile-menu-panel');

  if (mobileMenuButton && mobileMenuPanel) {
    mobileMenuButton.addEventListener('click', () => {
      const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      mobileMenuButton.setAttribute('aria-expanded', String(!isOpen));
      mobileMenuPanel.classList.toggle('hidden', isOpen);
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;

      if (!mobileMenuButton.contains(target) && !mobileMenuPanel.contains(target)) {
        mobileMenuButton.setAttribute('aria-expanded', 'false');
        mobileMenuPanel.classList.add('hidden');
      }
    });
  }
</script>
