---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RoyalEnfieldSection from '../components/RoyalEnfieldSection.astro';

const youtubeUrl = 'https://youtube.com/@unbunueloenmoto';
const categories = ['Motos', 'Productos', 'Beneficios', 'Rutas'];
const posts = (await getCollection('blog')).sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf());
const postCategories = (post: (typeof posts)[number]) => post.data.categories ?? (post.data.category ? [post.data.category] : []);
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const regularPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : [];
const dateFormat = { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' } as const;
const formatDate = (date: Date) => date.toLocaleDateString('es-CO', dateFormat);
---

<Layout
  title="Blog | Un Buñuelo en Moto"
  description="Rutas, historias, consejos y aprendizajes de Un Buñuelo en Moto."
  canonicalPath="/blog/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog de Un Buñuelo en Moto',
    url: 'https://unbunueloenmoto.com/blog/',
    description: 'Rutas, historias, consejos y aprendizajes sobre motociclismo.',
    inLanguage: 'es-CO',
  }}
>
  <SiteHeader currentPage="blog" />

  <main id="main-content">
    <section class="bg-retro-dark px-5 pb-16 pt-40 md:px-10 md:pb-24 lg:px-[72px]" data-reveal>
      <div class="mx-auto max-w-[1176px]">
        <h1 class="max-w-4xl text-balance text-[clamp(3rem,8vw,6rem)] font-bold leading-[0.92] tracking-[-0.03em]">Historias para<br /><em class="not-italic text-neon">seguir rodando.</em></h1>
        <p class="mt-7 max-w-[65ch] text-base leading-relaxed text-retro-crema/80 md:text-lg">Pruebas de motos, rutas y equipo que acompaña cada salida.</p>
      </div>
    </section>

    <nav class="mx-auto max-w-[1176px] px-5 py-10 md:px-10 md:py-14 lg:px-0" aria-label="Categorías del blog" data-reveal>
      <div class="flex gap-2 overflow-x-auto sm:flex-wrap sm:gap-3" data-blog-filters>
        <button class="min-h-11 shrink-0 rounded-full bg-neon px-4 py-3 text-[13px] font-bold text-retro-dark transition-colors" type="button" data-category-filter="Todos" aria-pressed="true">Todos</button>
        {categories.map((category) => (
          <button
            class="min-h-11 shrink-0 rounded-full bg-asfalto/20 px-4 py-3 text-[13px] font-bold text-retro-crema/85 transition-colors hover:bg-asfalto/50 hover:text-neon"
            type="button"
            data-category-filter={category}
            aria-pressed="false"
          >
            {category}
          </button>
        ))}
      </div>
    </nav>

    <AdSlot slot={import.meta.env.PUBLIC_GOOGLE_ADSENSE_SLOT_BLOG_TOP} />

    <section class="mx-auto max-w-[1176px] px-5 pb-20 md:px-10 md:pb-28 lg:px-0" id="articulos" aria-label="Publicaciones">
      <p class="mb-7 hidden text-base font-semibold text-retro-crema/80" data-blog-result-count aria-live="polite"></p>
      {featuredPost ? <article class="grid overflow-hidden rounded-2xl border border-asfalto/20 bg-asfalto/10 sm:rounded-3xl md:grid-cols-[1.1fr_1fr]" data-blog-post data-categories={postCategories(featuredPost).join('|')} data-reveal>
        <img class="aspect-[4/3] w-full object-cover md:h-full md:min-h-[320px] md:aspect-auto" src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="eager" />
        <div class="flex flex-col justify-end p-5 sm:p-7 md:p-12"><p class="mb-4 flex flex-wrap gap-x-2 text-sm font-bold text-neon sm:mb-5"><span>Artículo destacado</span>{postCategories(featuredPost).map((category) => <span>{category}</span>)}</p><h2 class="text-balance text-[1.75rem] font-bold leading-[1.05] tracking-[-0.02em] sm:text-3xl md:text-5xl">{featuredPost.data.title}</h2><p class="mt-4 max-w-[60ch] text-base leading-relaxed text-retro-crema/80 sm:mt-5">{featuredPost.data.description}</p><a class="mt-6 inline-flex min-h-11 items-center text-base font-bold text-neon underline decoration-transparent transition-colors hover:decoration-current sm:mt-8" href={`/blog/${featuredPost.id}`}>Leer la historia</a></div>
      </article> : null}

      {regularPosts.length > 0 ? (
        <div class="mt-14 grid gap-x-5 gap-y-12 sm:mt-20 sm:gap-y-16 md:grid-cols-2 lg:grid-cols-3" data-blog-post-list data-reveal-stagger>
          {regularPosts.map((post) => (
            <article class="group" data-blog-post data-categories={postCategories(post).join('|')}>
              <a class="block" href={`/blog/${post.id}`} aria-label={`Leer: ${post.data.title}`}>
                <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-asfalto/10"><img class="size-full object-cover transition duration-500 group-hover:scale-105" src={post.data.heroImage} alt={post.data.title} loading="lazy" /></div>
                <div class="pt-5"><div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-semibold text-neon">{postCategories(post).map((category) => <span>{category}</span>)}<span class="text-retro-crema/75">{formatDate(post.data.date)}</span></div><h2 class="mt-3 text-balance text-2xl font-bold leading-tight tracking-[-0.02em] transition-colors group-hover:text-neon">{post.data.title}</h2><p class="mt-3 text-base leading-relaxed text-retro-crema/80">{post.data.description}</p><span class="mt-4 inline-flex min-h-11 items-center text-base font-bold text-retro-crema underline decoration-transparent transition-colors group-hover:decoration-current">Leer más</span></div>
              </a>
            </article>
          ))}
        </div>
      ) : null}
      <div class="hidden rounded-2xl bg-asfalto/20 px-6 py-12 text-center sm:px-10" data-blog-empty-state aria-live="polite">
        <h2 class="text-balance text-2xl font-bold leading-tight sm:text-3xl">Aún no hay publicaciones en esta categoría.</h2>
        <p class="mx-auto mt-4 max-w-[55ch] text-base leading-relaxed text-retro-crema/80">Puedes explorar todas las historias mientras llega la próxima.</p>
        <button class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-bunuelo px-5 text-sm font-bold text-retro-dark transition-colors duration-200 hover:bg-bunuelo-dark active:scale-[0.98]" type="button" data-clear-category>Ver todas las publicaciones</button>
      </div>
    </section>

    <RoyalEnfieldSection />

    <section class="bg-asfalto/10 px-5 py-20 md:px-10 md:py-28 lg:px-[72px]" data-reveal>
      <div class="mx-auto flex max-w-[1176px] flex-col gap-8 md:flex-row md:items-end md:justify-between"><div><h2 class="max-w-[18ch] text-balance text-[clamp(2rem,4vw,3.25rem)] font-bold leading-tight tracking-[-0.03em]">La ruta continúa en YouTube.</h2></div><a class="inline-flex min-h-12 w-fit items-center justify-center rounded-full bg-bunuelo px-6 text-sm font-bold text-retro-dark transition-colors duration-200 hover:bg-bunuelo-dark active:scale-[0.98]" href={youtubeUrl} target="_blank" rel="noreferrer">Ver vídeos en YouTube</a></div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-filter]'));
  const postCards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-post]'));
  const postList = document.querySelector<HTMLElement>('[data-blog-post-list]');
  const emptyState = document.querySelector<HTMLElement>('[data-blog-empty-state]');
  const resultCount = document.querySelector<HTMLElement>('[data-blog-result-count]');

  const applyCategory = (category: string | null) => {
  const visiblePosts = postCards.filter((post) => !category || post.dataset.categories?.split('|').includes(category));

    postCards.forEach((post) => post.classList.toggle('hidden', !visiblePosts.includes(post)));
    postList?.classList.toggle('hidden', visiblePosts.filter((post) => post.parentElement === postList).length === 0);
    emptyState?.classList.toggle('hidden', visiblePosts.length > 0);

    filters.forEach((filter) => {
      const isActive = filter.dataset.categoryFilter === (category ?? 'Todos');
      filter.classList.toggle('bg-neon', isActive);
      filter.classList.toggle('text-retro-dark', isActive);
      filter.classList.toggle('bg-asfalto/20', !isActive);
      filter.classList.toggle('text-retro-crema/85', !isActive);
      filter.classList.toggle('hover:bg-asfalto/50', !isActive);
      filter.classList.toggle('hover:text-neon', !isActive);
      filter.setAttribute('aria-pressed', String(isActive));
    });

    if (resultCount) {
      resultCount.textContent = category && visiblePosts.length > 0 ? `${visiblePosts.length} ${visiblePosts.length === 1 ? 'publicación' : 'publicaciones'} en ${category}.` : '';
      resultCount.classList.toggle('hidden', !category || visiblePosts.length === 0);
    }
  };

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const selectedCategory = filter.dataset.categoryFilter;
      applyCategory(selectedCategory && selectedCategory !== 'Todos' ? selectedCategory : null);
      document.getElementById('articulos')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelector<HTMLButtonElement>('[data-clear-category]')?.addEventListener('click', () => {
    applyCategory(null);
    document.getElementById('articulos')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  applyCategory(null);
</script>
