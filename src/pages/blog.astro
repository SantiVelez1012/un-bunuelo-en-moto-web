---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

const youtubeUrl = 'https://youtube.com/@unbunueloenmoto';
const posts = (await getCollection('blog')).sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const regularPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : [];
const formatDate = (date: Date) => date.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout
  title="Blog | Un Buñuelo en Moto"
  description="Rutas, historias, consejos y aprendizajes de Un Buñuelo en Moto."
  canonicalPath="/blog/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog de Un Buñuelo en Moto',
    url: 'https://unbunueloenmoto.com/blog/',
    description: 'Rutas, historias, consejos y aprendizajes sobre motociclismo.',
    inLanguage: 'es-CO',
  }}
>
  <SiteHeader currentPage="blog" />

  <main>
    <section class="border-b border-asfalto/20 bg-retro-dark px-5 pb-20 pt-40 md:px-10 md:pb-28 lg:px-[72px]" data-reveal>
      <div class="mx-auto max-w-[1176px]">
        <p class="mb-5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon">El cuaderno de ruta</p>
        <h1 class="max-w-4xl text-[clamp(3.5rem,9vw,8rem)] font-bold leading-[0.88] tracking-[-0.07em]">Historias para<br /><em class="not-italic text-neon">seguir rodando.</em></h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-retro-crema/70">Crónicas, consejos y pensamientos nacidos entre el garaje, la carretera y las conversaciones que aparecen en el camino.</p>
      </div>
    </section>

    <section class="mx-auto max-w-[1176px] px-5 py-16 md:px-10 lg:px-0" aria-label="Categorías del blog" data-reveal>
      <div class="flex flex-wrap gap-3 border-b border-asfalto/20 pb-8 text-xs font-bold uppercase tracking-[0.14em] text-retro-crema/60">
        <a class="rounded-full bg-neon px-4 py-3 text-retro-dark" href="#articulos">Todos</a>
        <a class="rounded-full border border-asfalto/20 px-4 py-3 transition hover:border-neon hover:text-neon" href="#rutas">Rutas</a>
        <a class="rounded-full border border-asfalto/20 px-4 py-3 transition hover:border-neon hover:text-neon" href="#garaje">Garaje</a>
        <a class="rounded-full border border-asfalto/20 px-4 py-3 transition hover:border-neon hover:text-neon" href="#consejos">Consejos</a>
        <a class="rounded-full border border-asfalto/20 px-4 py-3 transition hover:border-neon hover:text-neon" href="#historias">Historias</a>
      </div>
    </section>

    <AdSlot slot={import.meta.env.PUBLIC_GOOGLE_ADSENSE_SLOT_BLOG_TOP} />

    <section class="mx-auto max-w-[1176px] px-5 pb-24 md:px-10 md:pb-36 lg:px-0" id="articulos">
      {featuredPost ? <article class="grid overflow-hidden rounded-3xl border border-asfalto/20 bg-asfalto/10 md:grid-cols-[1.1fr_1fr]" data-reveal>
        <img class="h-full min-h-[320px] w-full object-cover" src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="eager" />
        <div class="flex flex-col justify-end p-7 md:p-12"><p class="mb-5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon">Artículo destacado · {featuredPost.data.category}</p><h2 class="text-3xl font-bold leading-tight tracking-tight md:text-5xl">{featuredPost.data.title}</h2><p class="mt-5 max-w-md leading-relaxed text-retro-crema/70">{featuredPost.data.description}</p><a class="mt-8 inline-flex min-h-11 items-center gap-3 text-sm font-bold text-neon" href={`/blog/${featuredPost.id}`}>Leer la historia <span aria-hidden="true">↗</span></a></div>
      </article> : <p class="rounded-3xl border border-asfalto/20 bg-asfalto/10 p-8 text-retro-crema/70">Todavía no hay publicaciones disponibles.</p>}

      <div class="mt-20 grid gap-x-5 gap-y-16 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {regularPosts.map((post) => (
          <article class="group" id={post.data.category.toLowerCase()}>
            <a class="block" href={`/blog/${post.id}`} aria-label={`Leer: ${post.data.title}`}>
              <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-asfalto/10"><img class="size-full object-cover transition duration-500 group-hover:scale-105" src={post.data.heroImage} alt={post.data.title} loading="lazy" /></div>
              <div class="pt-5"><div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.14em] text-neon"><span>{post.data.category}</span><span class="text-retro-crema/45">{formatDate(post.data.date)}</span></div><h2 class="mt-4 text-2xl font-bold leading-tight tracking-tight transition-colors group-hover:text-neon">{post.data.title}</h2><p class="mt-3 text-sm leading-relaxed text-retro-crema/65">{post.data.description}</p><span class="mt-5 inline-flex text-sm font-bold text-retro-crema">Leer más <span class="ml-2 text-neon" aria-hidden="true">↗</span></span></div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-asfalto/10 px-5 py-24 md:px-10 md:py-32 lg:px-[72px]" data-reveal>
      <div class="mx-auto flex max-w-[1176px] flex-col gap-8 md:flex-row md:items-end md:justify-between"><div><p class="mb-5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon">Del blog al canal</p><h2 class="max-w-2xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">La mejor historia todavía está en la carretera.</h2></div><a class="inline-flex min-h-12 w-fit items-center justify-center gap-3 rounded-full bg-bunuelo px-6 text-[13px] font-bold text-retro-dark transition hover:bg-bunuelo-dark hover:-translate-y-0.5" href={youtubeUrl} target="_blank" rel="noreferrer">Ver vídeos en YouTube <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>

  <SiteFooter />
</Layout>
