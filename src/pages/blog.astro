---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RoyalEnfieldSection from '../components/RoyalEnfieldSection.astro';

const youtubeUrl = 'https://youtube.com/@unbunueloenmoto';
const categories = ['Motos', 'Beneficios', 'Rutas', 'Articulos moteros'];
const posts = (await getCollection('blog')).sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf());
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const regularPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : [];
const dateFormat = { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' } as const;
const formatDate = (date: Date) => date.toLocaleDateString('es-CO', dateFormat);
---

<Layout
  title="Blog | Un Buñuelo en Moto"
  description="Rutas, historias, consejos y aprendizajes de Un Buñuelo en Moto."
  canonicalPath="/blog/"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog de Un Buñuelo en Moto',
    url: 'https://unbunueloenmoto.com/blog/',
    description: 'Rutas, historias, consejos y aprendizajes sobre motociclismo.',
    inLanguage: 'es-CO',
  }}
>
  <SiteHeader currentPage="blog" />

  <main>
    <section class="border-b border-asfalto/20 bg-retro-dark px-5 pb-20 pt-40 md:px-10 md:pb-28 lg:px-[72px]" data-reveal>
      <div class="mx-auto max-w-[1176px]">
        <p class="mb-5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon">El cuaderno de ruta</p>
        <h1 class="max-w-4xl text-[clamp(3.5rem,9vw,8rem)] font-bold leading-[0.88] tracking-[-0.07em]">Historias para<br /><em class="not-italic text-neon">seguir rodando.</em></h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-retro-crema/70">Crónicas, consejos y pensamientos nacidos entre el garaje, la carretera y las conversaciones que aparecen en el camino.</p>
      </div>
    </section>

    <section class="mx-auto max-w-[1176px] px-5 py-12 md:px-10 md:py-16 lg:px-0" aria-label="Categorías del blog" data-reveal>
      <div class="flex gap-2 overflow-x-auto border-b border-asfalto/20 pb-6 text-xs font-bold uppercase tracking-[0.14em] text-retro-crema/60 sm:flex-wrap sm:gap-3 sm:pb-8" data-blog-filters>
        <a class="shrink-0 rounded-full bg-neon px-4 py-3 text-retro-dark transition" href="/blog" data-category-filter="Todos" data-scroll-target="articulos">Todos</a>
        {categories.map((category) => (
          <a
            class="shrink-0 rounded-full border border-asfalto/20 px-4 py-3 transition hover:border-neon hover:text-neon"
            href={`/blog?category=${encodeURIComponent(category)}`}
            data-category-filter={category}
            data-scroll-target={category.toLowerCase().replace(/\s+/g, '-')}
          >
            {category}
          </a>
        ))}
      </div>
    </section>

    <AdSlot slot={import.meta.env.PUBLIC_GOOGLE_ADSENSE_SLOT_BLOG_TOP} />

    <section class="mx-auto max-w-[1176px] px-5 pb-20 md:px-10 md:pb-36 lg:px-0" id="articulos">
      <p class="mb-7 hidden text-sm font-semibold text-retro-crema/65" data-blog-result-count aria-live="polite"></p>
      {featuredPost ? <article class="grid overflow-hidden rounded-2xl border border-asfalto/20 bg-asfalto/10 sm:rounded-3xl md:grid-cols-[1.1fr_1fr]" data-blog-post data-category={featuredPost.data.category} data-reveal>
        <img class="aspect-[4/3] w-full object-cover md:h-full md:min-h-[320px] md:aspect-auto" src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="eager" />
        <div class="flex flex-col justify-end p-5 sm:p-7 md:p-12"><p class="mb-4 text-[10px] font-bold uppercase tracking-[0.14em] text-neon sm:mb-5 sm:text-[11px] sm:tracking-[0.2em]">Artículo destacado · {featuredPost.data.category}</p><h2 class="text-[1.75rem] font-bold leading-[1.05] tracking-tight sm:text-3xl md:text-5xl">{featuredPost.data.title}</h2><p class="mt-4 max-w-md text-sm leading-relaxed text-retro-crema/70 sm:mt-5 sm:text-base">{featuredPost.data.description}</p><a class="mt-6 inline-flex min-h-11 items-center gap-3 text-sm font-bold text-neon sm:mt-8" href={`/blog/${featuredPost.id}`}>Leer la historia <span aria-hidden="true">↗</span></a></div>
      </article> : null}

      {regularPosts.length > 0 ? (
        <div class="mt-14 grid gap-x-5 gap-y-12 sm:mt-20 sm:gap-y-16 md:grid-cols-2 lg:grid-cols-3" data-blog-post-list data-reveal-stagger>
          {regularPosts.map((post) => (
            <article class="group" id={post.data.category.toLowerCase().replace(/\s+/g, '-') } data-blog-post data-category={post.data.category}>
              <a class="block" href={`/blog/${post.id}`} aria-label={`Leer: ${post.data.title}`}>
                <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-asfalto/10"><img class="size-full object-cover transition duration-500 group-hover:scale-105" src={post.data.heroImage} alt={post.data.title} loading="lazy" /></div>
                <div class="pt-5"><div class="flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.14em] text-neon"><span>{post.data.category}</span><span class="text-retro-crema/45">{formatDate(post.data.date)}</span></div><h2 class="mt-4 text-2xl font-bold leading-tight tracking-tight transition-colors group-hover:text-neon">{post.data.title}</h2><p class="mt-3 text-sm leading-relaxed text-retro-crema/65">{post.data.description}</p><span class="mt-5 inline-flex text-sm font-bold text-retro-crema">Leer más <span class="ml-2 text-neon" aria-hidden="true">↗</span></span></div>
              </a>
            </article>
          ))}
        </div>
      ) : null}
      <div class="hidden rounded-2xl border border-asfalto/20 bg-asfalto/10 px-6 py-12 text-center sm:rounded-3xl sm:px-10" data-blog-empty-state aria-live="polite">
        <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-neon">Próxima parada</p>
        <h2 class="mt-4 text-2xl font-bold leading-tight sm:text-3xl">Aún no hay publicaciones en esta categoría.</h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-retro-crema/70">Estamos preparando nuevas historias para la ruta. Explora todas las publicaciones mientras tanto.</p>
        <a class="mt-7 inline-flex min-h-11 items-center justify-center rounded-full bg-bunuelo px-5 text-sm font-bold text-retro-dark transition-all duration-300 ease-out hover:-translate-y-0.5 hover:bg-bunuelo-dark" href="/blog" data-clear-category>Ver todas las publicaciones</a>
      </div>
    </section>

    <RoyalEnfieldSection />

    <section class="bg-asfalto/10 px-5 py-24 md:px-10 md:py-32 lg:px-[72px]" data-reveal>
      <div class="mx-auto flex max-w-[1176px] flex-col gap-8 md:flex-row md:items-end md:justify-between"><div><p class="mb-5 text-[11px] font-bold uppercase tracking-[0.2em] text-neon">Del blog al canal</p><h2 class="max-w-2xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">La mejor historia todavía está en la carretera.</h2></div><a class="inline-flex min-h-12 w-fit items-center justify-center gap-3 rounded-full bg-bunuelo px-6 text-[13px] font-bold text-retro-dark transition hover:bg-bunuelo-dark hover:-translate-y-0.5" href={youtubeUrl} target="_blank" rel="noreferrer">Ver vídeos en YouTube <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-category-filter]'));
  const postCards = Array.from(document.querySelectorAll<HTMLElement>('[data-blog-post]'));
  const postList = document.querySelector<HTMLElement>('[data-blog-post-list]');
  const emptyState = document.querySelector<HTMLElement>('[data-blog-empty-state]');
  const resultCount = document.querySelector<HTMLElement>('[data-blog-result-count]');
  const activeClasses = ['bg-neon', 'text-retro-dark'];
  const inactiveClasses = ['border', 'border-asfalto/20', 'hover:border-neon', 'hover:text-neon'];

  const applyCategory = (category: string | null) => {
    const visiblePosts = postCards.filter((post) => !category || post.dataset.category === category);

    postCards.forEach((post) => post.classList.toggle('hidden', !visiblePosts.includes(post)));
    postList?.classList.toggle('hidden', visiblePosts.filter((post) => post.parentElement === postList).length === 0);
    emptyState?.classList.toggle('hidden', visiblePosts.length > 0);

    filters.forEach((filter) => {
      const isActive = filter.dataset.categoryFilter === (category ?? 'Todos');
      filter.classList.toggle('bg-neon', isActive);
      filter.classList.toggle('text-retro-dark', isActive);
      inactiveClasses.forEach((className) => filter.classList.toggle(className, !isActive));
    });

    if (resultCount) {
      resultCount.textContent = category && visiblePosts.length > 0 ? `${visiblePosts.length} publicación${visiblePosts.length === 1 ? '' : 'es'} en ${category}.` : '';
      resultCount.classList.toggle('hidden', !category || visiblePosts.length === 0);
    }
  };

  const updateFromUrl = () => {
    const category = new URLSearchParams(window.location.search).get('category');
    applyCategory(filters.some((filter) => filter.dataset.categoryFilter === category) ? category : null);
  };

  filters.forEach((filter) => {
    filter.addEventListener('click', (event) => {
      event.preventDefault();
      window.history.pushState({}, '', filter.href);
      updateFromUrl();
      document.getElementById('articulos')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  window.addEventListener('popstate', updateFromUrl);
  updateFromUrl();
</script>
