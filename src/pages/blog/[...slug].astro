---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdSlot from '../../components/AdSlot.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, categories, date, heroImage, tags, affiliateUrl, affiliateLabel, affiliateOffer } = post.data;
const postCategories = categories ?? (category ? [category] : []);
const dateFormat = { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' } as const;
const formattedDate = date.toLocaleDateString('es-CO', dateFormat);
const articleImage = new URL(heroImage, Astro.site ?? 'https://unbunueloenmoto.com').href;
---

<Layout
  title={`${title} | Un Buñuelo en Moto`}
  description={description}
  canonicalPath={`/blog/${post.id}/`}
  image={articleImage}
  type="article"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: articleImage,
    datePublished: date.toISOString(),
    articleSection: postCategories.join(', '),
    author: { '@type': 'Person', name: 'Un Buñuelo en Moto' },
    publisher: { '@type': 'Organization', name: 'Un Buñuelo en Moto' },
    mainEntityOfPage: `https://unbunueloenmoto.com/blog/${post.id}/`,
    inLanguage: 'es-CO',
  }}
>
  <SiteHeader currentPage="blog" />

  <main id="main-content">
    <article>
      <header class="bg-retro-dark px-5 pb-16 pt-40 md:px-10 md:pb-24 lg:px-[72px]" data-reveal>
        <div class="mx-auto max-w-[900px]">
          <a class="mb-8 inline-flex min-h-11 items-center text-base font-semibold text-neon underline decoration-transparent transition-colors hover:text-retro-crema hover:decoration-current" href="/blog">Volver al blog</a>
            <p class="mb-5 flex flex-wrap gap-x-2 gap-y-1 text-sm font-semibold text-neon">{postCategories.map((postCategory) => <span>{postCategory}</span>)}<span class="text-retro-crema/75">{formattedDate}</span></p>
          <h1 class="max-w-4xl text-balance font-display text-[clamp(2.5rem,7vw,5.5rem)] font-semibold leading-[0.96] tracking-[-0.03em] text-retro-crema">{title}</h1>
          <p class="mt-7 max-w-[65ch] text-base leading-relaxed text-retro-crema/85 md:text-lg">{description}</p>
          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-retro-crema/75">{tags.map((tag) => <span>#{tag}</span>)}</div>
        </div>
      </header>

      <AdSlot slot={import.meta.env.PUBLIC_GOOGLE_ADSENSE_SLOT_ARTICLE_TOP} />

      <div class="mx-auto max-w-[1200px] px-5 py-12 md:px-10 md:py-20 lg:px-0" data-reveal>
        <img class="aspect-[4/3] w-full rounded-2xl object-cover md:aspect-[16/8]" src={heroImage} alt={title} loading="eager" fetchpriority="high" />
      </div>

      <div class="prose prose-invert mx-auto max-w-[720px] px-5 pb-24 text-base leading-relaxed text-retro-crema/90 md:px-10 md:pb-36 md:text-lg lg:px-0 prose-p:my-6 prose-p:leading-[1.75] prose-a:font-semibold prose-a:text-neon prose-a:underline prose-a:decoration-transparent prose-a:underline-offset-4 hover:prose-a:decoration-current prose-strong:font-bold prose-strong:text-bunuelo prose-ul:my-7 prose-ul:space-y-3 prose-li:pl-1 prose-li:marker:text-neon prose-img:my-10 prose-img:w-full prose-img:rounded-2xl prose-blockquote:my-10 prose-blockquote:rounded-xl prose-blockquote:bg-asfalto/30 prose-blockquote:px-6 prose-blockquote:py-5 prose-blockquote:font-display prose-blockquote:text-xl prose-blockquote:font-semibold prose-blockquote:leading-snug prose-blockquote:text-retro-crema prose-blockquote:not-italic [&_h1]:mb-8 [&_h1]:mt-14 [&_h1]:font-display [&_h1]:text-4xl [&_h1]:font-semibold [&_h1]:leading-[0.98] [&_h1]:text-neon [&_h2]:mb-5 [&_h2]:mt-14 [&_h2]:font-display [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:text-neon md:[&_h2]:text-4xl [&_h3]:mb-4 [&_h3]:mt-10 [&_h3]:font-display [&_h3]:text-2xl [&_h3]:font-semibold [&_h3]:leading-tight [&_h3]:text-bunuelo md:[&_h3]:text-3xl" data-reveal>
        <Content />

        {affiliateUrl && affiliateLabel && <aside class="not-prose mt-12 rounded-2xl bg-asfalto/30 p-6 sm:p-8" aria-label="Enlace de compra recomendado">
          <h2 class="font-display text-3xl font-semibold leading-tight text-retro-crema">{affiliateLabel}</h2>
          {affiliateOffer && <p class="mt-3 text-base leading-relaxed text-retro-crema/85">{affiliateOffer}</p>}
          <a class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-bunuelo px-6 text-sm font-bold text-retro-dark transition-colors duration-200 hover:bg-bunuelo-dark active:scale-[0.98]" href={affiliateUrl} target="_blank" rel="noreferrer sponsored">Ver oferta</a>
        </aside>}
      </div>
    </article>
  </main>

  <SiteFooter />
</Layout>
