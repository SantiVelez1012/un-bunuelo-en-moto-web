---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import RoyalEnfieldSection from "../components/RoyalEnfieldSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const youtubeUrl = "https://youtube.com/@unbunueloenmoto";
const latestPosts = (await getCollection('blog'))
  .sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())
  .slice(0, 3);
const postCategories = (post: (typeof latestPosts)[number]) => post.data.categories ?? (post.data.category ? [post.data.category] : []);
const featuredPost = latestPosts[0];
const supportingPosts = latestPosts.slice(1);
const dateFormat = { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' } as const;
const formatDate = (date: Date) => date.toLocaleDateString('es-CO', dateFormat);
---

<Layout
  title="Un Buñuelo en Moto | Rodar, aprender y contar el camino"
  description="Acompaña a Un Buñuelo en Moto en rutas, motos, experiencias y aprendizajes sobre dos ruedas."
  canonicalPath="/"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Un Buñuelo en Moto",
    url: "https://unbunueloenmoto.com/",
    description: "Rutas, motos y aprendizajes sobre dos ruedas.",
    inLanguage: "es-CO",
  }}
>
  <SiteHeader currentPage="home" />

  <main id="main-content">
    <section
      class="relative flex min-h-[100svh] items-end overflow-hidden bg-retro-dark"
      id="inicio"
    >
      <img
        class="absolute inset-0 size-full object-cover object-center"
        src="/images/hero-banner.jpg"
        fetchpriority="high"
        alt="Cflite Dual 250 - Autódromo de Tocancipá"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-retro-dark/95 via-retro-dark/55 to-retro-dark/20"
      >
      </div>
      <div
        class="absolute inset-0 bg-gradient-to-t from-retro-dark via-transparent to-transparent"
      >
      </div>
      <div
        class="relative z-10 mx-auto w-full max-w-[1320px] px-5 pb-24 pt-36 md:px-10 md:pb-[105px] lg:px-[72px]"
      >
        <h1
          class="mb-7 max-w-[1100px] text-balance text-[clamp(3rem,8vw,6.75rem)] font-bold leading-[0.94] tracking-[-0.03em]"
          data-hero-item
        >
          Rodar, aprender<br /><em class="not-italic text-neon"
            >y contar el camino.</em
          >
        </h1>
        <p
          class="mb-9 max-w-[470px] text-base leading-relaxed text-retro-crema/70 md:text-lg"
          data-hero-item
        >
          Soy Un Buñuelo en Moto, un canal colombiano de rutas, motos y todo lo
          que voy aprendiendo en cada kilómetro.
        </p>
        <div
          class="flex flex-col items-start gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-7"
          data-hero-item
        >
          <a
            class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-bunuelo px-6 text-[13px] font-bold text-retro-dark transition hover:bg-bunuelo-dark hover:-translate-y-0.5"
            href={youtubeUrl}
            target="_blank"
            rel="noreferrer"
            >Suscribirme en YouTube</a
          >
          <a
            class="text-[13px] font-bold text-retro-crema transition-colors hover:text-neon"
            href="#sobre-mi"
            data-scroll-target="sobre-mi"
            >Conocer mi historia</a
          >
        </div>
      </div>
    </section>

    <AdSlot slot={import.meta.env.PUBLIC_GOOGLE_ADSENSE_SLOT_HOME} />

    <section
      class="mx-auto grid max-w-[1320px] items-center gap-12 px-5 py-24 md:px-10 md:py-36 lg:grid-cols-[minmax(260px,.85fr)_minmax(300px,1fr)] lg:gap-[10vw] lg:px-[72px]"
      id="sobre-mi"
      data-reveal
    >
      <div class="relative aspect-[4/5] overflow-hidden rounded-2xl md:aspect-[3/4]">
        <img
          class="absolute inset-0 h-full w-full object-cover object-center"
          src="/images/about-rider.jpg"
          alt="Cruzando un puente en la AKT TTR 200"
          loading="lazy"
        />
      </div>
      <div>
        <h2
          class="mb-7 text-balance text-[clamp(2.625rem,6vw,5rem)] font-bold leading-[0.95] tracking-[-0.03em]"
        >
          Más allá<br />de las rutas.
        </h2>
        <p class="max-w-[510px] text-[17px] leading-[1.7] text-retro-crema/70">
          No soy experto en todo. Soy alguien que disfruta aprender, equivocarse
          y seguir avanzando sobre dos ruedas. Este canal es mi forma de
          compartir el garaje, las carreteras y las historias que aparecen
          durante el camino.
        </p>
        <a class="mt-8 inline-flex min-h-11 items-center text-base font-bold text-neon underline decoration-transparent transition-colors hover:decoration-current" href="/blog">Explorar el blog</a>
      </div>
    </section>

    <section class="mx-auto max-w-[1320px] px-5 py-20 md:px-10 md:py-28 lg:px-[72px]" id="blog" aria-labelledby="home-blog-title" data-reveal>
      <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <h2 id="home-blog-title" class="text-balance font-display text-4xl font-semibold leading-tight tracking-[-0.03em] sm:text-5xl">Del garaje, al blog.</h2>
        <a class="min-h-11 inline-flex items-center text-base font-bold text-neon underline decoration-transparent transition-colors hover:decoration-current" href="/blog">Todas las publicaciones</a>
      </div>

      {featuredPost ? <div class="grid items-start gap-10 lg:grid-cols-[1.1fr_.9fr] lg:gap-14">
        <article class="group">
          <a class="block" href={`/blog/${featuredPost.id}`}>
            <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-asfalto/20">
              <img class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]" src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="lazy" />
            </div>
            <h3 class="mt-5 max-w-3xl text-balance font-display text-[22px] font-semibold leading-tight transition-colors group-hover:text-neon sm:text-3xl md:text-4xl">{featuredPost.data.title}</h3>
            <p class="mt-4 max-w-[65ch] text-base leading-relaxed text-retro-crema/75">{featuredPost.data.description}</p>
            <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm font-semibold text-neon">{postCategories(featuredPost).map((category) => <span>{category}</span>)}<span class="text-retro-crema/70">{formatDate(featuredPost.data.date)}</span></p>
          </a>
        </article>

        <div class="flex flex-col gap-8 lg:pt-1">
          {supportingPosts.map((post) => (
            <article class="group">
              <a class="grid grid-cols-[minmax(96px,0.42fr)_1fr] items-start gap-5 sm:grid-cols-[minmax(120px,0.42fr)_1fr]" href={`/blog/${post.id}`}>
                <div class="aspect-[4/3] overflow-hidden rounded-xl bg-asfalto/20">
                  <img class="size-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]" src={post.data.heroImage} alt={post.data.title} loading="lazy" />
                </div>
                <div>
                  <h3 class="mt-2 text-balance font-display text-xl font-semibold leading-snug transition-colors group-hover:text-neon sm:text-2xl">{post.data.title}</h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-retro-crema/75">{post.data.description}</p>
                  <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-sm font-semibold text-neon">{postCategories(post).map((category) => <span>{category}</span>)}<span class="text-retro-crema/70">{formatDate(post.data.date)}</span></p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div> : <p class="text-base text-retro-crema/75">Todavía no hay publicaciones disponibles.</p>}
    </section>

    <RoyalEnfieldSection />

    <section class="bg-asfalto/10 px-5 py-20 md:px-10 md:py-28 lg:px-[72px]" id="contenido" data-reveal>
      <div class="mx-auto max-w-[1176px]">
        <div class="mb-14 max-w-3xl">
          <h2 id="comunidad" class="text-balance text-[clamp(2.625rem,6vw,5rem)] font-bold leading-[0.95] tracking-[-0.03em]">La ruta sigue en redes.</h2>
          <p class="mt-6 max-w-[65ch] text-base leading-relaxed text-retro-crema/80 md:text-lg">Videos, rutas y conversaciones de la comunidad, también fuera de la carretera.</p>
        </div>
        <div class="grid gap-10 md:grid-cols-[1fr_1fr] md:gap-16" data-reveal-stagger>
          <a class="group flex min-h-[220px] flex-col justify-between rounded-2xl bg-neon p-7 text-retro-dark transition-transform duration-200 ease-out hover:-translate-y-1 active:scale-[0.99] sm:p-9" href="https://www.instagram.com/unbunueloenmoto/" target="_blank" rel="noreferrer">
            <span class="font-display text-3xl font-semibold leading-tight sm:text-4xl">Motos y rutas en Instagram.</span>
            <span class="inline-flex min-h-11 items-center text-base font-bold underline decoration-transparent transition-colors group-hover:decoration-current">Seguir en Instagram</span>
          </a>
          <div class="flex flex-col justify-center gap-3">
            <a class="flex min-h-14 items-center justify-between gap-4 text-lg font-semibold transition-colors hover:text-neon" href={youtubeUrl} target="_blank" rel="noreferrer"><span>YouTube</span><span class="text-sm text-retro-crema/65">Rutas y pruebas</span></a>
            <a class="flex min-h-14 items-center justify-between gap-4 text-lg font-semibold transition-colors hover:text-neon" href="https://www.tiktok.com/@unbunueloenmoto" target="_blank" rel="noreferrer"><span>TikTok</span><span class="text-sm text-retro-crema/65">Clips de carretera</span></a>
            <a class="flex min-h-14 items-center justify-between gap-4 text-lg font-semibold transition-colors hover:text-neon" href="https://www.facebook.com/profile.php?id=61565367096663" target="_blank" rel="noreferrer"><span>Facebook</span><span class="text-sm text-retro-crema/65">La comunidad</span></a>
          </div>
        </div>
      </div>
    </section>

    <section
      class="mx-auto grid max-w-[1320px] items-end gap-12 px-5 py-24 md:px-10 md:py-36 lg:grid-cols-[1fr_auto] lg:gap-16 lg:px-[72px]"
      id="comunidad"
      data-reveal
    >
      <div>
        <h2 class="mb-6 max-w-3xl text-balance text-[clamp(2.625rem,6vw,5rem)] font-bold leading-[0.95] tracking-[-0.03em]">Nos vemos en la próxima ruta.</h2>
        <p class="max-w-[65ch] text-base leading-relaxed text-retro-crema/80 md:text-lg">Acompáñame en el canal y cuéntame qué moto o camino quieres ver después.</p>
      </div>
      <div class="flex flex-col items-start gap-7 lg:items-end">
        <a
          class="inline-flex min-h-12 items-center justify-center rounded-full bg-bunuelo px-6 text-sm font-bold text-retro-dark transition-colors duration-200 hover:bg-bunuelo-dark active:scale-[0.98]"
          href={youtubeUrl}
          target="_blank"
          rel="noreferrer"
          >Ir al canal de YouTube</a
        >
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>

